# Addresses for the deployment VM. Committed on purpose: it holds no secrets.
# Set the public hostname before the first deploy; the API refuses to start in
# production with development values still in place.
LAB_ENV=server
LAB_CORS_ORIGINS=["https://rlalab-assist.dept.ic.ac.uk:8445"]
LAB_APP_PUBLIC_URL=https://rlalab-assist.dept.ic.ac.uk:8445/assist
# Single-VM storage: all API/worker containers share the persistent objects volume.
# Back up this volume with PostgreSQL to storage outside the VM.
LAB_OBJECT_STORE_KIND=filesystem
LAB_ALLOW_FILESYSTEM_IN_PRODUCTION=true
LAB_OBJECT_STORE_ROOT=/var/lib/lab-assistant/objects
# Optional S3 alternative: select s3 and set bucket, endpoint, region here,
# with access credentials in .env. Existing objects are not migrated automatically.
LAB_EMBEDDING_MODEL_CACHE=/var/lib/lab-assistant/model-cache
LAB_API_URL=http://api:8000
LAB_LOG_FORMAT=json
LAB_ROW_LEVEL_SECURITY_ENABLED=false
LAB_MALWARE_SCAN_REQUIRED_FOR_UPLOADS=true
