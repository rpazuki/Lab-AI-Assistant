# Install as /etc/nginx/conf.d/lab-assistant.conf on the HOST.
server {
    listen 8445 ssl;
    server_name rlalab-assist.dept.ic.ac.uk;
    ssl_certificate /etc/pki/tls/certs/biopipeline-fullchain.pem;
    # Replace with the matching key path already used by biopipeline2.conf.
    ssl_certificate_key /etc/pki/tls/private/REPLACE_WITH_EXISTING_KEY.key;
    client_max_body_size 50m;
    location = / { return 302 /assist; }
    location / {
        proxy_pass http://127.0.0.1:3300;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
