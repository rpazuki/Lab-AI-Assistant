# Secrets and behaviour only. NO hostnames, ports, or URLs — see ADR-0012.
#
#   cp .env.example .env
#   set -a; source .env; set +a     # safe: this file holds no addresses
#
# Addresses live in .env.compose / .env.server (committed) and are injected by the
# compose file that owns them.

# local | compose | server. Everything else derives from this.
LAB_ENV=local

# Who this installation is, as distinct from the library or workspace it serves.
# Recorded in every recovery manifest, and the reason `lab backup restore` can
# tell a clone from a takeover: restoring a backup twice otherwise produces two
# installations that each believe they are the publisher, and they diverge
# silently. Leave it unset and the identity is derived from this installation's
# own addresses — which is the right default, because a restore onto a new host
# then correctly derives a different one. Set it explicitly before a planned
# move that means to keep publishing, since a derived identity does not survive
# a deliberate address change.
#   python -c "import uuid; print(uuid.uuid4())"
# LAB_INSTALLATION_ID=
# Incremented by a fenced handover. Phase 4 makes it durable; today it is here so
# a backup taken now is readable by the implementation that does.
# LAB_WRITER_EPOCH=0

# publisher | reader. What this deployment is *for*, as distinct from what any
# person may do inside it: an admin on a reader still cannot publish, because
# the machine is not the publisher.
#
# It is NOT read-only. A reader writes constantly — logins, rate buckets, audit,
# chat sessions, messages, feedback — and search is itself a POST. What a reader
# may not do is change the corpus: acquire sources, parse them, extract claims,
# curate what is included, or decide what is published.
#
# A reader also builds no connectors, parsers, extractor or scanner, so it needs
# no source API keys and no ClamAV socket to serve a corpus somebody else
# approved. Default is publisher, so an installation that predates this setting
# keeps every capability it had.
# LAB_INSTALLATION_ROLE=publisher

# Archive manifest signing (phase 2). A digest proves the bytes did not rot; a
# signature establishes who approved them, and anyone who can write to the
# bucket can write a correct digest. Ed25519, raw 32-byte keys, base64.
#   python -c "import sys;sys.path.insert(0,'packages/python');from lab_assistant.adapters.signing import generate_keypair;p,k=generate_keypair();print('private:',p);print('public :',k)"
# The private key is a path, not a value: an environment variable reaches
# process listings, crash dumps and support bundles, and a signing key that has
# been in one is a key to rotate.
# LAB_ARCHIVE_SIGNING_KEY_PATH=/run/secrets/archive-signing.key
# LAB_ARCHIVE_SIGNING_KEY_ID=rla-publisher-2026
# Keys this deployment trusts, as id=base64 pairs. Pinned here and never read
# from the archive: a key fetched from beside the manifest is a key the
# manifest's author chose. Rotation means listing both for the overlap.
# LAB_ARCHIVE_TRUSTED_KEYS=rla-publisher-2026=<base64>,rla-publisher-2027=<base64>
# Refuse a snapshot that is unsigned or signed by an unknown key. A signature
# that fails to verify always blocks, whatever this is set to.
# LAB_ARCHIVE_REQUIRE_SIGNATURE=false
# How long a policy checkpoint this publisher issues may be relied on. A reader
# that cannot refresh stops serving restricted material when it lapses, so this
# bounds how long a revocation can go unseen — and the publisher must re-issue
# inside it (`lab archive policy publish --apply`, on a timer). ADR-0025.
# LAB_ARCHIVE_POLICY_VALIDITY_HOURS=24
# A longer offline window for unrestricted material only. 0 means none. Signed
# into the checkpoint, so this is the steward's approval, not a reader's.
# LAB_ARCHIVE_POLICY_PUBLIC_VALIDITY_HOURS=0

# Database credentials. The compose files build DATABASE_URL from these so the
# password has exactly one owner; never write a DATABASE_URL with a password into
# an address file.
POSTGRES_DB=lab_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-locally

# Session signing. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
LAB_SECRET_KEY=development-only-not-for-production
LAB_ACCESS_TOKEN_TTL_MINUTES=480
# Sign-in attempts per minute, per account and per client origin. Enforced by a
# store-backed bucket, so it holds across workers and across a deploy.
LAB_LOGIN_RATE_LIMIT_PER_MINUTE=10

# Model provider. `fake` is the deterministic offline provider; production uses an
# approved provider and the model-transfer policy still gates every call.
LAB_LLM_PROVIDER=fake
LAB_LLM_MODEL=claude-sonnet-4-6
# LAB_LLM_API_KEY=
LAB_EXTERNAL_MODEL_ENABLED=false

# Embeddings. `hashing-v1` is deterministic and offline; a real profile is chosen
# on measured recall (ADR-0013), not inherited.
LAB_EMBEDDING_PROFILE=hashing-v1
LAB_EMBEDDING_BATCH_SIZE=32

# Object store credentials. Bucket, prefix, endpoint, and region are addresses and
# live in .env.server; only the credentials belong here. The single-VM server
# profile explicitly permits filesystem storage; leave these absent when using it.
#
# Leave all four unset to use the SDK credential chain — an instance role, a
# container role, or web identity — which is the only way a credential refreshes
# inside a job longer than its session (ADR-0023). Set both keys or neither: half
# a pair is refused rather than falling through to the chain as someone else.
# LAB_OBJECT_STORE_ACCESS_KEY=
# LAB_OBJECT_STORE_SECRET_KEY=
# LAB_OBJECT_STORE_SESSION_TOKEN=
# LAB_OBJECT_STORE_PROFILE=
#
# Refuse a payload larger than this, checked while reading rather than after.
# 0 leaves the acquisition ceiling (64 MiB) as the only limit.
# LAB_OBJECT_STORE_MAX_OBJECT_BYTES=0
# At or above this, an upload goes in parts and a failed transfer resumes from a
# part boundary. S3 requires every part but the last to be at least 5 MiB.
# LAB_OBJECT_STORE_MULTIPART_THRESHOLD_BYTES=8388608

# Google Cloud Storage (LAB_OBJECT_STORE_KIND=gcs, ADR-0024). The bucket, prefix
# and multipart threshold above apply here too; these two are GCS-only.
# Prefer workload identity to a key file: a key file is a credential that does
# not expire and has to be rotated by somebody remembering to.
# LAB_OBJECT_STORE_PROJECT=
# LAB_OBJECT_STORE_CREDENTIALS_PATH=

# Migration destination, for `lab storage migrate`. Mirrors the settings above so
# both stores can be described at once. Set only while a migration is in flight.
# LAB_MIGRATE_OBJECT_STORE_KIND=s3
# LAB_MIGRATE_OBJECT_STORE_BUCKET=
# LAB_MIGRATE_OBJECT_STORE_REGION=
# LAB_MIGRATE_OBJECT_STORE_ENDPOINT=
# LAB_MIGRATE_OBJECT_STORE_PREFIX=
# LAB_MIGRATE_OBJECT_STORE_ACCESS_KEY=
# LAB_MIGRATE_OBJECT_STORE_SECRET_KEY=
# For a GCS destination: LAB_MIGRATE_OBJECT_STORE_KIND=gcs plus BUCKET, and
# PROJECT / CREDENTIALS_PATH / PREFIX as needed.

# Connector identity. Several scholarly services require a contact address on
# every request, and Unpaywall is not registered at all without one — see
# `lab config connectors` for what a deployment actually has.
# LAB_CONNECTOR_CONTACT=ops@example.ac.uk
# LAB_NCBI_API_KEY=

# Retrieval
LAB_RETRIEVAL_LEXICAL_TOP_K=20
LAB_RETRIEVAL_VECTOR_TOP_K=20
LAB_RETRIEVAL_FINAL_TOP_K=8

# Staged controls (scale §3.2). Each flag changes enforcement depth, never schema.
LAB_ROW_LEVEL_SECURITY_ENABLED=false
LAB_MALWARE_SCAN_REQUIRED_FOR_UPLOADS=true
LAB_MALWARE_SCAN_REQUIRED_FOR_OPEN_ACCESS=false
LAB_DOUBLE_REVIEW_ENABLED=false
LAB_TRACING_ENABLED=false

LAB_LOG_LEVEL=INFO
