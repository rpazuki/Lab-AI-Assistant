# This host's own addresses and role, for an installation that is not the
# Imperial VM. Copy to .env.site (uncommitted) on that host only.
#
# Why a third file: .env.server is committed, holds the Imperial VM's addresses,
# and is read after .env, so a mirror cannot override it from .env — and the
# deploy script refuses a checkout with local edits, so it cannot be edited in
# place either. .env.site is read last and wins. Like .env.server it holds no
# secrets: passwords and API keys stay in .env.

# ── addresses ────────────────────────────────────────────────────────────────
LAB_CORS_ORIGINS=["https://assist.example.org"]
LAB_APP_PUBLIC_URL=https://assist.example.org/assist

# ── role ─────────────────────────────────────────────────────────────────────
# A mirror serves an imported corpus. The deploy script reads this and runs no
# workers and no scanner (infra/compose/docker-compose.reader.yml).
LAB_INSTALLATION_ROLE=reader

# ── shared archive ───────────────────────────────────────────────────────────
# Where `lab archive` publishes and fetches. The private object store above
# stays filesystem on both machines: only the archive commands use the bucket.
# Publisher and readers must agree on the bucket and the prefix.
LAB_ARCHIVE_STORE_KIND=gcs
LAB_ARCHIVE_STORE_BUCKET=your-bucket
LAB_ARCHIVE_STORE_PROJECT=your-project
LAB_ARCHIVE_STORE_PREFIX=archive
# Only where the host has no attached service account (a Google VM does): a
# key file under /etc/lab-assistant, which scripts/archive.sh mounts read-only.
# LAB_ARCHIVE_STORE_CREDENTIALS_PATH=/etc/lab-assistant/gcs-reader.json

# The publisher's library: on a reader, what `scripts/archive.sh sync` fetches.
# Not secret. The publisher prints it (`scripts/archive.sh publish` reports it).
LAB_ARCHIVE_LIBRARY_ID=00000000-0000-0000-0000-000000000000
