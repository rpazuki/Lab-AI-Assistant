# Addresses for containers on a developer machine. Committed on purpose: it holds
# no secrets. DATABASE_URL is absent — docker-compose.yml builds it from
# POSTGRES_* under `environment:` so the password has exactly one owner.
LAB_ENV=compose
LAB_CORS_ORIGINS=["http://localhost:3000"]
LAB_APP_PUBLIC_URL=http://localhost:3000
LAB_OBJECT_STORE_ROOT=/var/lib/lab-assistant/objects
LAB_EMBEDDING_MODEL_CACHE=/var/lib/lab-assistant/model-cache
LAB_API_URL=http://api:8000
